// Test 9: Multiple closure chains with shared state
// Tests complex closure interactions and reference management

makeBank = fun() {
    balance = 100;
    
    deposit = fun(amount) {
        balance = balance + amount;
        return balance;
    };
    
    withdraw = fun(amount) {
        if (balance >= amount) {
            balance = balance - amount;
            return balance;
        }
        return balance;
    };
    
    getBalance = fun() {
        return balance;
    };
    
    return {deposit: deposit, withdraw: withdraw, balance: getBalance};
};

account = makeBank();
print(account.deposit(50));
print(account.withdraw(30));
print(account.balance());
// Create more accounts to stress GC
i = 0;
while (i < 20) {
    tempAccount = makeBank();
    tempAccount.deposit(i);
    i = i + 1;
}
print(account.balance());
